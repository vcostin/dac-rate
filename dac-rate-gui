#!/usr/bin/env python3
"""dac-rate-gui: a window and tray icon for dac-rate.

All changes go through the dac-rate command, so the app and the command line
always agree. The live hardware rate is read straight from /proc/asound.
"""

import json
import os
import shutil
import sys
from pathlib import Path

from PySide6.QtCore import QObject, QProcess, QSettings, Qt, QTimer, Signal
from PySide6.QtGui import QAction, QActionGroup, QColor, QFont, QIcon, QPainter, QPixmap
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtWidgets import (
    QApplication, QButtonGroup, QCheckBox, QComboBox, QFormLayout, QFrame,
    QHBoxLayout, QLabel, QLayout, QMainWindow, QMenu, QMessageBox, QProgressBar,
    QPushButton, QRadioButton, QSpinBox, QSystemTrayIcon, QToolButton,
    QVBoxLayout, QWidget,
)

VERSION = "1.2.0"
APP_NAME = "DAC Sample Rate"
MATCH_MODES = [
    ("card", "Whole card, any profile (recommended)"),
    ("port", "This card on this USB port only"),
    ("node", "This output only"),
]
AUTOSTART = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "autostart" / "dac-rate-gui.desktop"


def find_cli():
    """dac-rate next to this file (a checkout), else on PATH."""
    if os.environ.get("DAC_RATE_CLI"):
        return os.environ["DAC_RATE_CLI"]
    here = Path(__file__).resolve().parent / "dac-rate"
    if here.is_file() and os.access(here, os.X_OK):
        return str(here)
    return shutil.which("dac-rate")


def fmt_rate(hz):
    khz = hz / 1000
    return f"{khz:g} kHz"


def read_hw_rate(card, pcm):
    """Rate the device runs at now, or None when it is closed (idle)."""
    if card in (None, "") or pcm in (None, ""):
        return None
    try:
        text = Path(f"/proc/asound/card{card}/pcm{pcm}p/sub0/hw_params").read_text()
    except OSError:
        return None
    for line in text.splitlines():
        if line.startswith("rate:"):
            try:
                return int(line.split()[1])
            except (IndexError, ValueError):
                return None
    return None


def describe_rule(rule):
    if not rule:
        return "No dac-rate rule (PipeWire default)"
    mode = rule["mode"]
    text = "Auto: follows the content" if mode == "auto" else f"Locked to {fmt_rate(int(mode))}"
    scope = {"card": "whole card", "port": "this USB port", "node": "this output"}.get(rule.get("match"), rule.get("match"))
    parts = [text, f"applies to {scope}"]
    if rule.get("quality") is not None:
        parts.append(f"quality {rule['quality']}")
    return " · ".join(parts)


class Cli(QObject):
    """Runs dac-rate asynchronously, one command at a time."""

    finished = Signal(str, object, str, int)  # tag, parsed JSON (or None), stderr, exit code

    def __init__(self, path):
        super().__init__()
        self.path = path
        self.queue = []
        self.proc = None

    def busy(self):
        return self.proc is not None

    def run(self, tag, args):
        # Only one query of each kind needs to wait in line.
        if tag != "change" and any(t == tag for t, _ in self.queue):
            return
        self.queue.append((tag, args))
        self._next()

    def _next(self):
        if self.proc is not None or not self.queue:
            return
        tag, args = self.queue.pop(0)
        proc = QProcess(self)
        proc.setProgram(self.path)
        proc.setArguments(["--json", *args])
        proc.setProperty("tag", tag)
        proc.finished.connect(lambda code, _status, p=proc, t=tag: self._done(p, t, code))
        proc.errorOccurred.connect(lambda _err, p=proc, t=tag: self._failed(p, t))
        self.proc = proc
        proc.start()

    def shutdown(self):
        """Before quitting: let a change finish (so it is never cut in half), stop queries."""
        self.queue.clear()
        proc, self.proc = self.proc, None
        if proc is None:
            return
        proc.blockSignals(True)
        if proc.property("tag").startswith("change"):
            proc.waitForFinished(30000)
        else:
            proc.kill()
            proc.waitForFinished(2000)

    def _done(self, proc, tag, code):
        if proc is not self.proc:
            return  # stopped by shutdown()
        out = bytes(proc.readAllStandardOutput()).decode(errors="replace")
        err = bytes(proc.readAllStandardError()).decode(errors="replace").strip()
        data = None
        if out.strip():
            try:
                data = json.loads(out)
            except json.JSONDecodeError:
                data = None
        self.proc = None
        proc.deleteLater()
        self.finished.emit(tag, data, err, code)
        self._next()

    def _failed(self, proc, tag):
        if proc is not self.proc:
            return
        if proc.error() == QProcess.ProcessError.FailedToStart:
            self.proc = None
            proc.deleteLater()
            self.finished.emit(tag, None, f"could not run {self.path}", 127)
            self._next()


class MainWindow(QMainWindow):
    def __init__(self, cli, settings):
        super().__init__()
        self.cli = cli
        self.settings = settings
        self.tray = None
        self.devices = []
        self.node = None          # selected output
        self.status = None        # last status JSON for it
        self.rates = []
        self.rates_source = ""
        self.applying = False
        self.quitting = False
        self._loading = False  # True while the app itself sets the controls

        self.setWindowTitle(APP_NAME)
        self.setWindowIcon(QIcon.fromTheme("audio-card"))
        self._build()
        cli.finished.connect(self._on_cli)

        self.hw_timer = QTimer(self, interval=1000, timeout=self._update_hw)
        self.hw_timer.start()
        self.dev_timer = QTimer(self, interval=5000, timeout=self.refresh_devices)
        self.dev_timer.start()
        self.refresh_devices()

    # --- layout -------------------------------------------------------------

    def _build(self):
        root = QWidget()
        lay = QVBoxLayout(root)
        lay.setContentsMargins(18, 16, 18, 16)
        lay.setSpacing(12)
        # The window may never be smaller than its content (no clipped text).
        lay.setSizeConstraint(QLayout.SizeConstraint.SetMinimumSize)

        row = QHBoxLayout()
        row.addWidget(QLabel("Output device:"))
        self.device_combo = QComboBox()
        self.device_combo.setSizeAdjustPolicy(QComboBox.SizeAdjustPolicy.AdjustToMinimumContentsLengthWithIcon)
        self.device_combo.setMinimumContentsLength(24)
        self.device_combo.activated.connect(self._on_device_chosen)
        row.addWidget(self.device_combo, 1)
        refresh = QToolButton(icon=QIcon.fromTheme("view-refresh"), toolTip="Look for devices again")
        if refresh.icon().isNull():
            refresh.setText("Refresh")
        refresh.clicked.connect(self.refresh_devices)
        row.addWidget(refresh)
        lay.addLayout(row)

        # Live rate card
        card = QFrame(frameShape=QFrame.Shape.StyledPanel)
        card_lay = QVBoxLayout(card)
        card_lay.setContentsMargins(16, 12, 16, 12)
        self.hw_label = QLabel("—", alignment=Qt.AlignmentFlag.AlignCenter)
        font = self.hw_label.font()
        font.setPointSizeF(font.pointSizeF() * 2.6)
        font.setWeight(QFont.Weight.Bold)
        self.hw_label.setFont(font)
        self.hw_note = QLabel("", alignment=Qt.AlignmentFlag.AlignCenter)
        self.rule_label = QLabel("", alignment=Qt.AlignmentFlag.AlignCenter, wordWrap=True)
        self.rule_label.setEnabled(False)  # secondary text colour
        card_lay.addWidget(self.hw_label)
        card_lay.addWidget(self.hw_note)
        card_lay.addWidget(self.rule_label)
        lay.addWidget(card)

        # Choice
        lay.addWidget(QLabel("<b>Sample rate</b>"))
        self.mode_group = QButtonGroup(self)
        self.rb_auto = QRadioButton("Follow the content (Auto)")
        self.rb_auto.setToolTip("The DAC switches to each file's own rate while one source is playing.")
        self.rb_lock = QRadioButton("Lock to")
        self.rb_lock.setToolTip("Everything is resampled once, by PipeWire, to this rate.")
        self.rb_default = QRadioButton("PipeWire default (remove the dac-rate rule)")
        for i, rb in enumerate((self.rb_auto, self.rb_lock, self.rb_default)):
            self.mode_group.addButton(rb, i)
        self.mode_group.idToggled.connect(self._on_user_change)
        lay.addWidget(self.rb_auto)
        lock_row = QHBoxLayout()
        lock_row.addWidget(self.rb_lock)
        self.rate_combo = QComboBox()
        self.rate_combo.currentIndexChanged.connect(self._on_user_change)
        lock_row.addWidget(self.rate_combo)
        lock_row.addStretch(1)
        lay.addLayout(lock_row)
        lay.addWidget(self.rb_default)

        # Advanced
        self.adv_toggle = QToolButton(text="Advanced", checkable=True)
        self.adv_toggle.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextBesideIcon)
        self.adv_toggle.setArrowType(Qt.ArrowType.RightArrow)
        self.adv_toggle.setAutoRaise(True)
        self.adv_toggle.toggled.connect(self._toggle_advanced)
